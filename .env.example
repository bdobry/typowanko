# api-football.com (api-sports.io) API key — Pro plan
# Used for fetching WC 2026 match results and correct-score odds.
# Set this as a GitHub Actions secret named FOOTBALL_DATA_API_KEY for the deployed app,
# or copy to .env.local for local development.
VITE_API_FOOTBALL_KEY=your_api_football_key_here

# Cloudflare Worker URL for D1 snapshot sync. This is the Worker URL, not the D1 database ID.
# Set this as a GitHub Actions repository variable named SYNC_API_BASE for the deployed app.
VITE_SYNC_API_BASE=https://typowanko-sync.<your-workers-subdomain>.workers.dev
