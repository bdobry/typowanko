# football-data.org API key (free tier)
# Sign up at https://www.football-data.org/client/register to get a key.
# Used to automatically fetch match results for WC 2026 fixtures.
# Set this as a GitHub Actions secret named FOOTBALL_DATA_API_KEY for the
# deployed app, or copy to .env.local for local development.
VITE_FOOTBALL_DATA_API_KEY=your_football_data_api_key_here
